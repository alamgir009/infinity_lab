# Infinity Lab website environment variables.
# Copy this file to ".env" and fill in real values before running or building.
# IMPORTANT: Because Vite exposes VITE_* variables to the browser, never put
# secrets, private API keys, or credentials in these variables.

# Base URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph metadata, and sitemap.xml references.
# Example: https://infinitylab.co.in
VITE_SITE_URL=

# Contact form submission endpoint. Must accept a JSON POST and return JSON.
# Expected contract: { ok: true } on success; { message?: string } or a
# non-2xx status on failure. The form never fakes success: without this
# variable the submit button stays disabled with an explanatory notice.
# Example: https://formspree.io/f/your-form-id
VITE_FORM_ENDPOINT=

# Public contact details rendered on the Contact page and in the footer.
# These are safe to expose because a public business website already shows them.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
# Full street address of the company office, URL-encoded when necessary.
VITE_CONTACT_ADDRESS=
